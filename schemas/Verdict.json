      "title": "Suggested Weight Pct"
    },
    "verdict": {
      "enum": [
        "BUY",
        "ACCUMULATE",
        "HOLD",
        "TRIM",
        "SELL",
        "AVOID",
        "INSUFFICIENT_DATA"
