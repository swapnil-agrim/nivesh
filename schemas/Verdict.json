      "title": "Horizon",
      "type": "string"
    },
    "invalidation": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Invalidation",
      "type": "array"
    },
    "overrides": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Overrides",
      "type": "array"
    },
    "review_date": {
      "format": "date",
      "title": "Review Date",
      "type": "string"
    },
    "risk_notes": {
      "title": "Risk Notes",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
