        "ccy": {
          "enum": [
            "INR",
            "USD"
          ],
          "title": "Ccy",
          "type": "string"
        },
        "high": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "High"
        },
        "low": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Low"
        }
      },
      "required": [
        "low",
        "high",
        "ccy"
      ],
      "title": "EntryZone",
      "type": "object"
    }
  },
  "additionalProperties": false,
