{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "As Of"
        },
        "field": {
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "tool_call_id": {
          "minLength": 1,
          "title": "Tool Call Id",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "tool_call_id",
        "field",
        "value"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "KeyPoint": {
      "additionalProperties": false,
      "properties": {
        "claim": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Claim",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "claim",
        "evidence"
      ],
      "title": "KeyPoint",
      "type": "object"
    },
    "SectorTilt": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "sector": {
          "title": "Sector",
          "type": "string"
        },
        "tilt": {
          "enum": [
            "overweight",
            "neutral",
            "underweight"
          ],
          "title": "Tilt",
          "type": "string"
        }
      },
      "required": [
        "sector",
        "tilt",
        "evidence"
      ],
      "title": "SectorTilt",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agent": {
      "const": "macro",
      "default": "macro",
      "title": "Agent",
      "type": "string"
    },
    "as_of": {
      "format": "date",
      "title": "As Of",
      "type": "string"
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "data_gaps": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Data Gaps",
      "type": "array"
    },
    "key_points": {
      "default": [],
      "items": {
        "$ref": "#/$defs/KeyPoint"
      },
      "title": "Key Points",
      "type": "array"
    },
    "regime": {
      "enum": [
        "risk_on",
        "neutral",
        "risk_off",
        "insufficient_data"
      ],
      "title": "Regime",
      "type": "string"
    },
    "risks": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Risks",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "score": {
      "maximum": 100,
      "minimum": 0,
      "title": "Score",
      "type": "integer"
    },
    "sector_tilts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SectorTilt"
      },
      "title": "Sector Tilts",
      "type": "array"
    },
    "thesis": {
      "title": "Thesis",
      "type": "string"
    }
  },
  "required": [
    "as_of",
    "regime",
    "score",
    "confidence",
    "thesis"
  ],
  "title": "MacroView",
  "type": "object"
}
